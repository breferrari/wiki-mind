+					logPrefix: "test",
+					qmdAvailable: () => true,
+					spawnWorker: (_p, args) => spawned.push(args),
+				}),
+			);
+			assert.deepEqual(spawned, [[]]);
+		} finally {
+			rmTemp(dir);
+		}
+	});
+});
