filters:
  and:
    - file.inFolder("questions")
    - file.ext == "md"
    - file.name != "README"
properties:
  file.name:
    displayName: Question
  status:
    displayName: Status
  description:
    displayName: Summary
  date:
    displayName: Raised
views:
  - type: table
    name: Open
    filters:
      and:
        - status == "open"
    order:
      - file.name
      - description
      - date
  - type: table
    name: All by status
    groupBy:
      property: status
      direction: ASC
    order:
      - file.name
      - status
      - description
      - date
